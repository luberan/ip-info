{
  "name": "ip-info",
  "version": "1.0.0",
  "private": true,
  "description": "A privacy-conscious English-language IPv4 and IPv6 diagnostic tool on Cloudflare Workers.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luberan/ip-info.git"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "npm run build:assets && wrangler dev",
    "build:assets": "esbuild src/client/app.ts --bundle --format=esm --target=es2022 --minify --outfile=public/app.js",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.client.json",
    "test": "vitest run",
    "build": "npm run typecheck && npm run build:assets && wrangler deploy --dry-run --outdir .wrangler/build",
    "deploy": "npm run build:assets && wrangler deploy"
  },
  "dependencies": {
    "ipaddr.js": "^2.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.156.2"
  }
}
