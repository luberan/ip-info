{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ip-lukasberan",
  "main": "./src/index.ts",
  "compatibility_date": "2026-11-03",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "logpush": false,
  "routes": [
    {
      "pattern": "ip.lukasberan.cz",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  }
}
